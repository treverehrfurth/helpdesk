{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@it-helpdesk/shared": [
        "packages/shared/src/index.ts"
      ],
      "@it-helpdesk/ui": [
        "packages/ui/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  }
}
