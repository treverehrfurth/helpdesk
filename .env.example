# Shared repo environment

# Frontend-only
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=false
VITE_AUTH_MODE=mock
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=
VITE_ENTRA_REDIRECT_URI=

# Shared Entra values used by both frontend and API
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_ALL_USERS_GROUP_ID=
ENTRA_TECH_GROUP_ID=
ENTRA_ADMIN_GROUP_ID=
ENTRA_TECH_ROLE=HelpDesk.Tech
ENTRA_ADMIN_ROLE=HelpDesk.Admin
ENTRA_API_CLIENT_SECRET=

# Teams SSO — web app registration used to validate Teams-issued tokens
ENTRA_WEB_CLIENT_ID=
ENTRA_APP_ID_URI=
# Client secret for the web app registration — required to send Teams Activity
# Feed notifications (must match webApplicationInfo.id in teams/manifest.json)
ENTRA_WEB_CLIENT_SECRET=

# Teams Activity Feed notifications — Teams app external ID (from manifest.json "id" field)
# Optional: if absent, Teams push notifications are silently skipped
TEAMS_APP_ID=
# Public URL of the frontend — used to construct deep links in Teams push notifications
# Optional: if absent, Teams notifications are sent without a deep link
FRONTEND_URL=

# API
# SECURITY: Must NOT be set to "true" in production. Dev headers (x-dev-role,
# x-dev-email, x-dev-name) bypass all authentication. The default when unset
# is false — safe for production without any additional configuration.
ALLOW_DEV_HEADERS=true
DATABASE_URL=
PGSSLMODE=require
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=ticket-attachments

# Azure Functions local host
FUNCTIONS_WORKER_RUNTIME=node
